# --- Byte-compiled / caches ---
  __pycache__/
  *.py[cod]
  *$py.class
  *.so

  # --- Virtual environments ---
  .venv/
  venv/
  env/
  ENV/

  # --- Distribution / packaging ---
  build/
  dist/
  *.egg-info/
  *.egg

  # --- Environment / secrets ---
  .env
  .env.*
  *.key
  *.pem

  # --- ML data (never commit large videos / features / models) ---
  raw_videos/
  AUGMENTED_KEYPOINTS/
  features_data/
  *.mp4
  *.mov
  *.avi
  *.mkv
  *.npy
  *.npz
  *.h5
  *.hdf5
  *.pb
  *.tflite
  *.onnx
  *.pt
  *.pth
  *.ckpt

  # --- Reports generated by training / evaluation ---
  *.pdf
  *.png
  *.jpg
  *.csv
  !examples/**/*.png
  !docs/**/*.png

  # --- TensorBoard / experiment tracking ---
  runs/
  logs/
  mlruns/
  wandb/

  # --- Matplotlib / cv2 caches ---
  .matplotlib/

  # --- IDE / editor ---
  .vscode/
  .idea/
  *.swp
  *.swo
  *~

  # --- OS ---
  .DS_Store
  Thumbs.db
  desktop.ini

  # --- Test / coverage ---
  .pytest_cache/
  .coverage
  htmlcov/
  .mypy_cache/
  .ruff_cache/
